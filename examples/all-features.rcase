{
  "$schema": "../schemas/rcase.schema.json",
  "name": "RouteCase — Complete Feature Showcase v0.2.0",
  "baseUrl": "{{API_BASE_URL}}",
  "headers": {
    "Accept": "application/json",
    "x-api-key": "{{API_KEY}}",
    "User-Agent": "RouteCase/0.2.0"
  },
  "tests": [

    {
      "name": "1. Health Check (GET — no auth)",
      "method": "GET",
      "path": "/health",
      "success": [
        {
          "name": "Server is healthy",
          "expect": {
            "status": 200,
            "bodyContains": "ok",
            "maxDurationMs": 300
          }
        }
      ]
    },

    {
      "name": "2. Login & Capture Token (POST + capture)",
      "method": "POST",
      "path": "/auth/login",
      "success": [
        {
          "name": "Login and store accessToken for later requests",
          "description": "The 'capture' block extracts values from the response body. {{authToken}} and {{authUserId}} are now available to ALL subsequent test cases in this file.",
          "body": {
            "username": "tester_{{$randomInt}}",
            "password": "my-secure-password"
          },
          "capture": {
            "authToken": "accessToken",
            "authUserId": "userId"
          },
          "expect": {
            "status": 200,
            "bodyContains": "accessToken",
            "headers": {
              "content-type": "application/json"
            },
            "maxDurationMs": 500
          }
        }
      ],
      "errors": [
        {
          "name": "Wrong password returns 401",
          "body": {
            "username": "admin",
            "password": "wrong-password"
          },
          "expect": {
            "status": 401,
            "bodyContains": "Invalid credentials"
          }
        },
        {
          "name": "Missing username returns 400",
          "body": {
            "password": "some-password"
          },
          "expect": {
            "status": 400
          }
        }
      ]
    },

    {
      "name": "3. Create User (POST + dynamic variables + capture)",
      "method": "POST",
      "path": "/users",
      "headers": {
        "Authorization": "Bearer {{authToken}}",
        "Content-Type": "application/json"
      },
      "success": [
        {
          "name": "Register a unique user every run",
          "description": "{{$randomEmail}} generates a new email each run — no more 409 Conflict errors. {{$uuid}} creates a collision-free ID. {{$isoDate}} stamps the creation time.",
          "body": {
            "id": "{{$uuid}}",
            "name": "{{$randomName}}",
            "email": "{{$randomEmail}}",
            "role": "developer",
            "createdAt": "{{$isoDate}}"
          },
          "capture": {
            "createdUserId": "id"
          },
          "expect": {
            "status": 201,
            "bodyContains": "id",
            "headers": {
              "content-type": "application/json"
            },
            "maxDurationMs": 600
          }
        }
      ],
      "errors": [
        {
          "name": "Duplicate email returns 409",
          "body": {
            "email": "existing@example.com",
            "name": "Duplicate User"
          },
          "expect": {
            "status": 409,
            "bodyContains": "already exists"
          }
        },
        {
          "name": "Missing required email returns 422",
          "body": {
            "name": "No Email User"
          },
          "expect": {
            "status": 422,
            "bodyContains": "email is required"
          }
        }
      ]
    },

    {
      "name": "4. Get User by ID (GET + path param + chained variable)",
      "method": "GET",
      "path": "/users/{id}",
      "headers": {
        "Authorization": "Bearer {{authToken}}"
      },
      "success": [
        {
          "name": "Fetch the user we just created using {{createdUserId}}",
          "description": "{{createdUserId}} was captured from the POST /users response above. No copy-paste required.",
          "params": {
            "id": "{{createdUserId}}"
          },
          "expect": {
            "status": 200,
            "bodyContains": "email",
            "maxDurationMs": 250
          }
        }
      ],
      "errors": [
        {
          "name": "Non-existent user returns 404 with exact JSON body",
          "params": {
            "id": "usr_does_not_exist_99999"
          },
          "expect": {
            "status": 404,
            "bodyEquals": {
              "error": "Not Found",
              "message": "User not found"
            }
          }
        }
      ]
    },

    {
      "name": "5. List Users with Pagination (GET + query params)",
      "method": "GET",
      "path": "/users",
      "headers": {
        "Authorization": "Bearer {{authToken}}"
      },
      "success": [
        {
          "name": "Fetch first page of users",
          "query": {
            "page": 1,
            "limit": 10,
            "sort": "createdAt",
            "order": "desc"
          },
          "expect": {
            "status": 200,
            "bodyContains": "users",
            "maxDurationMs": 400
          }
        },
        {
          "name": "Search users by role filter",
          "query": {
            "role": "developer",
            "page": 1,
            "limit": 5
          },
          "expect": {
            "status": 200
          }
        }
      ],
      "errors": [
        {
          "name": "Negative page number returns 400",
          "query": {
            "page": -1,
            "limit": 10
          },
          "expect": {
            "status": 400,
            "bodyContains": "page must be"
          }
        }
      ]
    },

    {
      "name": "6. Full Replace User (PUT)",
      "method": "PUT",
      "path": "/users/{id}",
      "headers": {
        "Authorization": "Bearer {{authToken}}",
        "Content-Type": "application/json"
      },
      "success": [
        {
          "name": "Replace user profile completely",
          "params": {
            "id": "{{createdUserId}}"
          },
          "body": {
            "name": "{{$randomName}}",
            "email": "{{$randomEmail}}",
            "role": "admin",
            "updatedAt": "{{$isoDate}}"
          },
          "expect": {
            "status": 200,
            "bodyContains": "admin"
          }
        }
      ],
      "errors": [
        {
          "name": "Unauthorized PUT without valid token",
          "params": {
            "id": "{{createdUserId}}"
          },
          "headers": {
            "Authorization": "Bearer expired-or-invalid-token"
          },
          "body": {
            "name": "Hacker",
            "email": "hacker@evil.com"
          },
          "expect": {
            "status": 401,
            "bodyContains": "Unauthorized"
          }
        }
      ]
    },

    {
      "name": "7. Partial Update User (PATCH)",
      "method": "PATCH",
      "path": "/users/{id}",
      "headers": {
        "Authorization": "Bearer {{authToken}}",
        "Content-Type": "application/json"
      },
      "success": [
        {
          "name": "Update only the user's role",
          "params": {
            "id": "{{createdUserId}}"
          },
          "body": {
            "role": "moderator"
          },
          "expect": {
            "status": 200,
            "bodyContains": "moderator"
          }
        }
      ],
      "errors": [
        {
          "name": "PATCH on non-existent user returns 404",
          "params": {
            "id": "usr_ghost_0000"
          },
          "body": {
            "role": "admin"
          },
          "expect": {
            "status": 404
          }
        }
      ]
    },

    {
      "name": "8. Create Product with Dynamic UUID (POST)",
      "method": "POST",
      "path": "/products",
      "headers": {
        "Authorization": "Bearer {{authToken}}",
        "Content-Type": "application/json"
      },
      "success": [
        {
          "name": "Create product with dynamic UUID and random price suffix",
          "body": {
            "productId": "{{$uuid}}",
            "sku": "SKU-{{$randomInt}}",
            "name": "Premium Gadget {{$randomInt}}",
            "price": 49.99,
            "currency": "USD",
            "inStock": true,
            "tags": ["electronics", "new-arrival"],
            "createdAt": "{{$timestamp}}"
          },
          "capture": {
            "createdProductId": "productId"
          },
          "expect": {
            "status": 201,
            "bodyContains": "productId",
            "maxDurationMs": 500
          }
        }
      ],
      "errors": [
        {
          "name": "Negative price returns 422",
          "body": {
            "productId": "{{$uuid}}",
            "name": "Bad Product",
            "price": -10.00
          },
          "expect": {
            "status": 422,
            "bodyContains": "Price must be"
          }
        }
      ]
    },

    {
      "name": "9. Delete User (DELETE — uses chained ID)",
      "method": "DELETE",
      "path": "/users/{id}",
      "headers": {
        "Authorization": "Bearer {{authToken}}"
      },
      "success": [
        {
          "name": "Delete the user we created and updated above",
          "description": "{{createdUserId}} flows all the way from Step 3 (POST /users capture) through to this final cleanup step.",
          "params": {
            "id": "{{createdUserId}}"
          },
          "expect": {
            "status": 200,
            "bodyContains": "deleted"
          }
        }
      ],
      "errors": [
        {
          "name": "Forbidden: non-admin cannot delete another user",
          "params": {
            "id": "{{createdUserId}}"
          },
          "headers": {
            "Authorization": "Bearer standard-user-token"
          },
          "expect": {
            "status": 403,
            "bodyContains": "Forbidden"
          }
        }
      ]
    }

  ]
}
